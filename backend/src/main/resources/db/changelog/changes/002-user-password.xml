<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Training only: plain-text password column. Real Fineract stores hashed credentials. -->
    <changeSet id="002-app-user-password" author="training">
        <addColumn tableName="m_appuser">
            <column name="password" type="VARCHAR(100)" defaultValue="password">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="m_appuser">
            <column name="password" value="password"/>
            <where>username = 'mifos'</where>
        </update>
    </changeSet>

</databaseChangeLog>

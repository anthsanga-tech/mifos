<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="017-standing-instruction-run-schema" author="developer">
        <createTable tableName="m_savings_standing_instruction_run">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_savings_standing_instruction_run"
                             nullable="false"/>
            </column>
            <column name="standing_instruction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="business_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(255)"/>
            <column name="transfer_group_id" type="VARCHAR(36)"/>
            <column name="maker_checker_id" type="BIGINT"/>
            <column name="ran_on" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="m_savings_standing_instruction_run"
                baseColumnNames="standing_instruction_id"
                constraintName="fk_si_run_standing_instruction"
                referencedTableName="m_standing_instruction"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="m_savings_standing_instruction_run"
                baseColumnNames="maker_checker_id"
                constraintName="fk_si_run_maker_checker"
                referencedTableName="m_savings_maker_checker"
                referencedColumnNames="id"/>
        <createIndex indexName="idx_si_run_instruction_due_date"
                     tableName="m_savings_standing_instruction_run">
            <column name="standing_instruction_id"/>
            <column name="due_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

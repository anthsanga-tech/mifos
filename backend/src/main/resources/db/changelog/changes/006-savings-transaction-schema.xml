<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-savings-transaction" author="developer">
        <createTable tableName="m_savings_transaction">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="transaction_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>

            <column name="transaction_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>
        <addForeignKeyConstraint
                baseTableName="m_savings_transaction"
                baseColumnNames="savings_account_id"
                referencedTableName="m_savings_account"
                referencedColumnNames="id"
                constraintName="fk_savings_transaction_account"/>

    </changeSet>
</databaseChangeLog>
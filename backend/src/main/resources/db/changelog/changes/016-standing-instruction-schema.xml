<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="016-standing-instruction-schema" author="developer">
        <createTable tableName="m_standing_instruction">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_standing_instruction" nullable="false"/>
            </column>
            <column name="from_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="to_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="frequency" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="next_due" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="valid_to" type="DATE"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="m_standing_instruction"
                baseColumnNames="from_account_id"
                constraintName="fk_standing_instruction_from_account"
                referencedTableName="m_savings_account"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="m_standing_instruction"
                baseColumnNames="to_account_id"
                constraintName="fk_standing_instruction_to_account"
                referencedTableName="m_savings_account"
                referencedColumnNames="id"/>
        <createIndex indexName="idx_standing_instruction_from_account"
                     tableName="m_standing_instruction">
            <column name="from_account_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-savings-account-notes-and-audit-trail" author="developer">
        <createTable tableName="m_savings_account_note">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_savings_account_note" nullable="false"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="note_body" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="m_savings_account_note"
                baseColumnNames="savings_account_id"
                constraintName="fk_savings_account_note_account"
                referencedTableName="m_savings_account"
                referencedColumnNames="id"/>
        <createIndex indexName="idx_savings_account_note_account_created"
                     tableName="m_savings_account_note">
            <column name="savings_account_id"/>
            <column name="created_on"/>
            <column name="id"/>
        </createIndex>

        <createTable tableName="m_savings_account_audit_trail">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_savings_account_audit_trail" nullable="false"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="summary" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)"/>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="m_savings_account_audit_trail"
                baseColumnNames="savings_account_id"
                constraintName="fk_savings_account_audit_account"
                referencedTableName="m_savings_account"
                referencedColumnNames="id"/>
        <createIndex indexName="idx_savings_account_audit_account_created"
                     tableName="m_savings_account_audit_trail">
            <column name="savings_account_id"/>
            <column name="created_on"/>
            <column name="id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-add-interest-rule-to-savings-product" author="developer">
        <addColumn tableName="m_savings_product">

            <column name="nominal_annual_interest_rate"
                    type="DECIMAL(19, 6)"
                    defaultValueNumeric="0"
                    valueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="interest_calculation_frequency"
                    type="VARCHAR(20)"
                    defaultValue="DAILY"
                    value="DAILY">
                <constraints nullable="false"/>
            </column>

            <column name="interest_posting_frequency"
                    type="VARCHAR(20)"
                    defaultValue="MONTHLY"
                    value="MONTHLY">
                <constraints nullable="false"/>
            </column>

        </addColumn>

    </changeSet>
</databaseChangeLog>
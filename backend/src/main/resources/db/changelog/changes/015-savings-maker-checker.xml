<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015-savings-maker-checker" author="developer">
        <createTable tableName="m_savings_maker_checker">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_savings_maker_checker" nullable="false"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="command_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="made_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="made_on" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="checked_by" type="VARCHAR(100)"/>
            <column name="checked_on" type="TIMESTAMP"/>
            <column name="reject_reason" type="VARCHAR(500)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="m_savings_maker_checker"
                baseColumnNames="savings_account_id"
                constraintName="fk_savings_maker_checker_account"
                referencedTableName="m_savings_account"
                referencedColumnNames="id"/>

        <createIndex indexName="idx_savings_maker_checker_account_status"
                     tableName="m_savings_maker_checker">
            <column name="savings_account_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

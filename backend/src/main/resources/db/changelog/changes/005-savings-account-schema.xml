<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-savings-account" author="developer">
        <createTable tableName="m_savings_account">

            <column name="id" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="account_no" type="VARCHAR(100)">
                <constraints nullable="false"
                             unique="true"/>
            </column>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="balance" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_on" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="m_savings_account"
                baseColumnNames="client_id"
                referencedTableName="m_client"
                referencedColumnNames="id"
                constraintName="fk_savings_account_client"/>

        <addForeignKeyConstraint
                baseTableName="m_savings_account"
                baseColumnNames="product_id"
                referencedTableName="m_savings_product"
                referencedColumnNames="id"
                constraintName="fk_savings_account_product"/>

    </changeSet>
</databaseChangeLog>